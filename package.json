{
  "name": "lapakur",
  "private": true,
  "version": "0.1.0",
  "description": "Лендинг груминг-студии «Лапакюр» (Чебоксары)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "media": "node scripts/media.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "budget": "node scripts/budget.mjs",
    "check": "tsc --noEmit && eslint . && vitest run && node scripts/build.mjs && node scripts/budget.mjs",
    "shoot": "node scripts/shoot.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:network": "node scripts/shoot.mjs --no-build --network --out-dir docs/verification",
    "audit:security": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@fontsource/jost": "^5.2.0",
    "@fontsource/prata": "^5.2.0",
    "@fontsource/spectral": "^5.2.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ffmpeg-static": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.3.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
